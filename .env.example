# Copy to apps/web/.env.local and fill in values from your Supabase project.
# Never commit real values.

# Public (safe to expose to the browser; access is limited by Row Level Security)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Edge Functions). Set in Supabase, never in the frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# EMAIL_PROVIDER_API_KEY=
