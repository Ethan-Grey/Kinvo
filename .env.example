# Copy to apps/web/.env.local and fill in values from your Supabase project
# (Project Settings → API). Never commit real values.

# Public: safe in the browser, because Row Level Security limits what it can do.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: the public half of the Web Push key pair (docs/setup.md, section 8).
# Phone notifications stay off until it's set.
VITE_VAPID_PUBLIC_KEY=

# Local Supabase only (supabase/config.toml). Set in the Supabase dashboard for production.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Never put the service-role key anywhere the frontend can read it.
